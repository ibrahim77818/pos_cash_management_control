<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_cash_management_control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="Cash Management Control" id="pcm_cash_control_section" invisible="not pos_cash_control">
                    <setting id="pcm_opening_cash_control" string="Opening Cash Control"
                             help="How the opening cash of each session of this Point of Sale is set">
                        <field name="pos_pcm_opening_mode" widget="radio" class="o_light_label"
                               readonly="pos_has_active_session"/>
                        <div class="content-group mt16"
                             invisible="pos_pcm_opening_mode not in ('suggest_float', 'server_fixed_float')">
                            <div class="row mt8">
                                <label for="pos_pcm_float_amount" string="Fixed Float" class="col-lg-4 o_light_label"/>
                                <field name="pos_pcm_float_amount" readonly="pos_has_active_session"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_pcm_float_account_id" string="Float Transfer Account" class="col-lg-4 o_light_label"/>
                                <field name="pos_pcm_float_account_id" options="{'no_create': True}"
                                       readonly="pos_has_active_session"/>
                            </div>
                            <div class="text-muted mt8">
                                The gap between the last closing balance and the float is booked as a float transfer, not as a cash difference.
                            </div>
                        </div>
                        <div class="text-muted mt8" invisible="pos_pcm_opening_mode != 'server_last_closing'">
                            The first session of this Point of Sale has no previous closing balance and is counted by the cashier.
                        </div>
                    </setting>
                    <setting id="pcm_closing_cash_control" string="Closing Cash Control"
                             help="How the closing cash of each session of this Point of Sale is counted">
                        <field name="pos_pcm_closing_mode" widget="radio" class="o_light_label"
                               readonly="pos_has_active_session"/>
                    </setting>
                    <setting id="pcm_hide_daily_sale"
                             help="Only POS managers can download or print the Daily Sale report">
                        <field name="pos_pcm_hide_daily_sale" readonly="pos_has_active_session"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
