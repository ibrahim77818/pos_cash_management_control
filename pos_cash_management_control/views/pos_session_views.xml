<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.pos_cash_management_control</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='closing_balance']" position="after">
                <field name="pcm_cash_control" invisible="1"/>
                <field name="pcm_opening_mode" invisible="not pcm_cash_control"/>
                <field name="pcm_opened_by_server" invisible="not pcm_opened_by_server"/>
                <field name="pcm_float_statement_line_id" invisible="not pcm_float_statement_line_id"
                       groups="account.group_account_readonly"/>
                <field name="pcm_closing_mode" invisible="not pcm_cash_control"/>
                <field name="pcm_expected_cash" widget="monetary"
                       groups="point_of_sale.group_pos_manager"
                       invisible="not pcm_cash_control or state != 'closed'"/>
                <field name="pcm_counted_cash" widget="monetary"
                       invisible="not pcm_cash_control or state != 'closed'"/>
                <field name="pcm_cash_difference" widget="monetary"
                       groups="point_of_sale.group_pos_manager"
                       invisible="not pcm_cash_control or state != 'closed'"/>
            </xpath>
        </field>
    </record>
</odoo>
