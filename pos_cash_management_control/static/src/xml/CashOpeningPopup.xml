<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="CashOpeningPopup" t-inherit="point_of_sale.CashOpeningPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@class='opening-cash-section']" position="after">
            <div t-if="pcmIsSuggestFloat" class="pcm-opening-hint">
                <div>
                    <span>Suggested fixed float:</span> <b t-esc="env.pos.format_currency(pcmFloatAmount)"/>
                </div>
                <div t-if="pcmFloatGap" class="pcm-note">
                    <span>Last closing balance:</span> <t t-esc="env.pos.format_currency(pcmLastClosing)"/>
                    <div>The gap is recorded as a float transfer, not as a cash difference.</div>
                </div>
            </div>
            <div t-if="env.pos.pcmSettings().configured_opening_mode === 'server_last_closing' and pcmOpeningMode === 'standard'" class="pcm-opening-hint">
                No previous closing balance was found for this Point of Sale: please count the opening cash.
            </div>
        </xpath>
    </t>

</templates>
