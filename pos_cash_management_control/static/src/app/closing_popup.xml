<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_cash_management_control.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <!-- Blind count: the session total would reveal the expected cash -->
        <xpath expr="//span[@t-esc='env.utils.formatCurrency(props.orders_details.amount)']" position="attributes">
            <attribute name="t-if">!pcmBlind</attribute>
        </xpath>
        <xpath expr="//span[@t-esc='env.utils.formatCurrency(props.orders_details.amount)']" position="after">
            <span t-else="" class="amount pcm-hidden-amount">***</span>
        </xpath>

        <!-- Expected cash -->
        <xpath expr="//td[@t-esc='env.utils.formatCurrency(props.default_cash_details.amount)']" position="attributes">
            <attribute name="t-if">!pcmBlind</attribute>
        </xpath>
        <xpath expr="//td[@t-esc='env.utils.formatCurrency(props.default_cash_details.amount)']" position="after">
            <td t-else="" class="pcm-hidden-amount" title="Blind count: the expected cash is visible to managers only">Hidden</td>
        </xpath>

        <!-- Counted cash: no input when the server counts -->
        <xpath expr="//td[Input[contains(@tModel, 'default_cash_details')]]" position="attributes">
            <attribute name="t-if">!pcmServerCount</attribute>
        </xpath>
        <xpath expr="//td[Input[contains(@tModel, 'default_cash_details')]]" position="after">
            <td t-else="" class="pcm-server-count">
                <span t-esc="env.utils.formatCurrency(props.default_cash_details.amount)"/>
                <div class="pcm-note">Counted by the server</div>
            </td>
        </xpath>

        <!-- Difference -->
        <xpath expr="//td[@t-esc='env.utils.formatCurrency(getDifference(props.default_cash_details.id))']" position="attributes">
            <attribute name="t-if">!pcmBlind</attribute>
        </xpath>
        <xpath expr="//td[@t-esc='env.utils.formatCurrency(getDifference(props.default_cash_details.id))']" position="after">
            <td t-else="" class="pcm-hidden-amount">Hidden</td>
        </xpath>

        <!-- Opening / cash moves / cash payments breakdown -->
        <xpath expr="//tbody[contains(@class, 'cash-overview')]" position="attributes">
            <attribute name="t-if">!pcmBlind</attribute>
        </xpath>
        <xpath expr="//tbody[contains(@class, 'cash-overview')]" position="after">
            <tbody t-else="" class="pcm-blind-info">
                <tr>
                    <td colspan="4">Blind count: enter the cash you counted. The expected amount and the difference are reviewed by a manager.</td>
                </tr>
            </tbody>
        </xpath>

        <!-- Daily Sale (download and print) -->
        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="attributes">
            <attribute name="t-if">!pcmHideDailySale</attribute>
        </xpath>
        <xpath expr="//button[@t-if='hardwareProxy.printer']" position="attributes">
            <attribute name="t-if">hardwareProxy.printer and !pcmHideDailySale</attribute>
        </xpath>
    </t>

</templates>
